{
  "info": {
    "name": "Vecteron Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "contentId",
      "value": ""
    },
    {
      "key": "contactId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Public portfolio",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/content?kind=portfolio&page=1&limit=20"
      }
    },
    {
      "name": "Public services",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/content?kind=services"
      }
    },
    {
      "name": "Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/admin/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Check session",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/auth/session"
      }
    },
    {
      "name": "Create draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/content",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kind\": \"portfolio\",\n  \"title\": \"Example project\",\n  \"slug\": \"example-project\",\n  \"summary\": \"Short summary\",\n  \"body\": \"Project details\",\n  \"published\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('contentId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List admin content",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/content"
      }
    },
    {
      "name": "Publish content",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/content/{{contentId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"published\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Public detail",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/content/example-project"
      }
    },
    {
      "name": "Submit contact request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/contact-requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Example Visitor\",\n  \"email\": \"visitor@example.com\",\n  \"subject\": \"Project enquiry\",\n  \"message\": \"Please tell me more about your services.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('contactId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List contact requests",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/contact-requests"
      }
    },
    {
      "name": "Resolve contact request",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/contact-requests/{{contactId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"resolved\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete example content",
      "request": {
        "method": "DELETE",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/admin/content/{{contentId}}"
      }
    }
  ]
}
