generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PageType {
  HOME
  ABOUT
  SERVICES
  SERVICE_DETAIL
  SECTORS
  SECTOR_DETAIL
  IMPACT
  BLOG
  BLOG_DETAIL
  CONTACT
  CUSTOM
}

enum SectionType {
  HERO
  SERVICE_GRID
  SERVICE_DETAIL
  SECTOR_CARDS
  IMPACT_METRICS
  CASE_STUDY
  BLOG_PREVIEW
  TEAM
  LEADERSHIP
  FAQ
  CTA
  CONTACT_FORM
  GALLERY
  RICH_TEXT
  FOOTER
  CUSTOM
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  LOGIN
  LOGOUT
  UPLOAD
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  name         String
  passwordHash String
  role         UserRole             @default(EDITOR)
  isActive     Boolean              @default(true)
  roles        UserRoleAssignment[]
  pages        Page[]               @relation("PageAuthor")
  blogPosts    BlogPost[]           @relation("BlogPostAuthor")
  mediaAssets  MediaAsset[]
  auditLogs    AuditLog[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("users")
}

model Role {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  users       UserRoleAssignment[]
  permissions RolePermission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("permissions")
}

model UserRoleAssignment {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Page {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  type             PageType      @default(CUSTOM)
  status           PublishStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  metaKeywords     String[]
  canonicalUrl     String?
  openGraphImageId String?
  openGraphImage   MediaAsset?   @relation("PageOpenGraphImage", fields: [openGraphImageId], references: [id], onDelete: SetNull)
  authorId         String?
  author           User?         @relation("PageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  sections         Section[]
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type])
  @@index([status])
  @@map("pages")
}

model Section {
  id        String         @id @default(uuid())
  pageId    String
  page      Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      SectionType
  title     String?
  content   Json
  position  Int
  isVisible Boolean        @default(true)
  status    PublishStatus  @default(DRAFT)
  media     SectionMedia[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([pageId, position])
  @@index([pageId])
  @@index([type])
  @@map("sections")
}

model MediaAsset {
  id                 String         @id @default(uuid())
  type               MediaType      @default(IMAGE)
  url                String
  fileName           String
  altText            String?
  mimeType           String
  sizeBytes          Int
  width              Int?
  height             Int?
  uploadedById       String?
  uploadedBy         User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  sectionUsages      SectionMedia[]
  pageOpenGraphUsage Page[]         @relation("PageOpenGraphImage")
  blogFeaturedUsage  BlogPost[]     @relation("BlogPostFeaturedImage")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([type])
  @@map("media_assets")
}

model SectionMedia {
  sectionId String
  mediaId   String
  position  Int        @default(0)
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([sectionId, mediaId])
  @@map("section_media")
}

model BlogCategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("blog_categories")
}

model BlogTag {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("blog_tags")
}

model BlogPost {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  excerpt         String?
  body            Json
  status          PublishStatus @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  featuredImageId String?
  featuredImage   MediaAsset?   @relation("BlogPostFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId        String?
  author          User?         @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tags            BlogPostTag[]
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogPostTag {
  blogPostId String
  tagId      String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  tag        BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogPostId, tagId])
  @@map("blog_post_tags")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([isRead])
  @@map("contact_messages")
}

model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  entityType String
  entityId   String?
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
